{
    "export_path": "experiments/MoE_exps/MoE_multitask_finetune_freeze_dedicated_encoder_BA",
    "overwrite": true,
    "exp_name": "MoE_multitask_finetune_freeze_dedicated_encoder_BA",
    "RL_algorithm": "DQN",
    "RL_algorithm_args": {
        "n_steps": 5,
        "gamma": 1,
        "epsilon": 1e-7,
        "alpha": 0.6,
        "beta": 0.4,
        "beta_increment_per_sampling": 0.001,
        "TD_err_upper": 1.0,
        "num_env": 1,
        "max_episode_length": 100
    },
    "model_type": "MoE_model",
    "experts_args": {
            "experts":{
                "original_FINDER" : {
                    "expert_mode": "pretrained",
                    "model_dir": "experiments/MoE_exps/ORIGINAL_BA_FINDER",
                    "load_mode": "freeze"
                },
                "p_recon_expert" : {
                    "expert_mode": "pretrained",
                    "model_dir": "experiments/MoE_exps/precon_finetune_BA_FINDER_proc",
                    "load_mode": "freeze"
                },
                "p_ming_expert" : {
                    "expert_mode": "pretrained",
                    "model_dir": "experiments/MoE_exps/pming_finetune_BA_FINDER_proc",
                    "load_mode": "freeze"
                },
                "p_minsg_expert" : {
                    "expert_mode": "pretrained",
                    "model_dir": "experiments/MoE_exps/pminsg_finetune_BA_FINDER_proc",
                    "load_mode": "freeze"
                },
                "p_decor_expert" : {
                    "expert_mode": "pretrained",
                    "model_dir": "experiments/MoE_exps/pdecor_finetune_BA_FINDER_proc",
                    "load_mode": "freeze"
                },
                "p_link_expert" : {
                    "expert_mode": "pretrained",
                    "model_dir": "experiments/MoE_exps/plink_finetune_BA_FINDER_proc",
                    "load_mode": "freeze"
                }
            }
    },
    "decoder_args": {
        "decoder_type": "mlp_with_dedicated_encoder",
        "encoder_type": "FINDER_encoder_PyG",
        "encoder_args": {
                "embedding_size": 256,
                "activation": "relu",
                "weight_init": true,
                "num_node_features": 4,
                "max_bp_iter": 3,
                "inner_conv_normalize": false
        },
        "num_layers": 2,
        "dropout": 0,
        "activation": "relu",
        "normalization": "none",
        "w_initialization_std": 0.01,
        "reg_hidden": 32,
        "auxilary_input": true,
        "aux_dim": 4
    },
    "procedural_attrs": [
        "degree",
        "pagerank",
        "ones"
    ],
    "procedural_attrs_args": {
        "degree": {
            "normalize": true
        },
        "pagerank": {
            "normalize": true
        },
        "ones": {
            "num_features": 2
        }
    },
    "optimizer": "adam",
    "optimizer_args": {
        "lr": 0.0001,
        "weight_decay": 0.0005
    },
    "reward_function": "cndp",
    "buffer_capacity": 500000,
    "model_export_frequency": 1000,
    "curriculum": [
        {
            "type": "synthetic_diverse",
            "generators_args": {
                "barabasi_albert_graph": {"weight": 1, "min_n": 50, "max_n": 70, "args": {"m": 4}},
                "watts_strogatz_graph": {"weight": 1, "min_n": 50, "max_n": 70, "args": {"k": 10, "p": 0.5}}
            },
            "num_graphs": 200,
            "num_episodes": 10,
            "epsilon_start": 1,
            "epsilon_end": 0.05,
            "epsilon_step": 10000,
            "target_update_freq": 500,
            "num_training_iters": 100001,
            "batch_size": 128,
            "num_valid": 10,
            "num_initial_game_rounds": 1
        }

    ]
    ,
    "use_wandb": false,
    "device": "cuda",
    "seed": 424242,
    "aggregatorID": 0,
    "SSL_losses": [
        "recon_loss"
    ],
    "SSL_loss_args": {
        "recon_loss": {
            "alpha": 0.001
        }
    }
}
