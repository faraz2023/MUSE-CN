{
    "overwrite": true,
    "exp_name": "DQN_FINDER",
    "RL_algorithm": "DQN",
    "RL_algorithm_args": {
        "n_steps": 5,
        "gamma": 1,
        "epsilon": 1e-7,
        "alpha": 0.6,
        "beta": 0.4,
        "beta_increment_per_sampling": 0.001,
        "TD_err_upper": 1.0,
        "num_env": 1,
        "max_episode_length": 100
    },
    "model_type": "finder_dqn",
    "encoder_type": "Identity",
    "encoder_args": {},
    "decoder_args": {
        "activation": "relu",
        "reg_hidden": 32,
        "auxilary_input": true,
        "aux_dim": 4,
        "w_initialization_std": 0.01
    },
    "procedural_attrs": [
        "degree",
        "pagerank",
        "prone"
    ],
    "procedural_attrs_args": {
        "degree": {
            "normalize": true
        },
        "pagerank": {
            "normalize": true
        },
        "prone": {
            "emb_size": 32
        }
    },
    "optimizer": "adam",
    "optimizer_args": {
        "lr": 0.0001,
        "weight_decay": 0.0005
    },
    "reward_function": "cndp",
    "buffer_capacity": 500000,
    "model_export_frequency": 1000,
    "curriculum": null,
    "use_wandb": false,
    "device": "cuda",
    "seed": 8080,
    "aggregatorID": 0,
    "SSL_losses": [
        "recon_loss"
    ],
    "SSL_loss_args": {
        "recon_loss": {
            "alpha": 0.001
        }
    }
}
